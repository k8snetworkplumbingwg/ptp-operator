diff --git a/pkg/parser/ptp4l_parser.go b/pkg/parser/ptp4l_parser.go
index 60ef9b27..6d7c0077 100644
--- a/pkg/parser/ptp4l_parser.go
+++ b/pkg/parser/ptp4l_parser.go
@@ -41,7 +41,10 @@ var (
 			`\s+offset\s+(?P<offset>-?\d+)` +
 			`\s+(?P<servo_state>s\d)` +
 			`\s+freq\s+(?P<freq_adj>[-+]?\d+)` +
-			`\s*(?:path\s+delay\s+(?P<delay>\d+))?` +
+			// path delay can be negative when master/slave PHC epochs diverge
+			// (e.g. GNSS-synced BC → cold OC on netdevsim); still parse the line
+			// so clock_state/offset metrics are published.
+			`\s*(?:path\s+delay\s+(?P<delay>-?\d+))?` +
 			`$`,
 	)
 )
