+// convertToFloat converts an event field to float64.
+// Bool values map to 1 (true) and 0 (false).
+func convertToFloat(value interface{}) (float64, bool) {
+	switch val := value.(type) {
+	case int64:
+		return float64(val), true
+	case float64:
+		return val, true
+	case bool:
+		if val {
+			return 1, true
+		}
+		return 0, true
+	default:
+		return 0, false
+	}
+}
